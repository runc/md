{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "zeroConfig": true,
        "installCommand": "NPM_CONFIG_REGISTRY=https://registry.npmjs.org npx -y pnpm@10.24.0 i --frozen-lockfile",
        "buildCommand": "NPM_CONFIG_REGISTRY=https://registry.npmjs.org npx -y pnpm@10.24.0 web build:only",
        "outputDirectory": "apps/web/dist"
      }
    }
  ]
}
